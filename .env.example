# Copy this file to packages/web/.env for local development.
# Never commit real values — .env files are gitignored.

# Supabase project URL.
# Local dev: http://127.0.0.1:54321 (printed by `supabase start`).
# Production: https://<project-ref>.supabase.co (Dashboard → Settings → API).
VITE_SUPABASE_URL=

# Supabase anonymous (public) API key. Safe to expose to the browser —
# row-level security is what protects the data, not this key.
# Local dev: printed by `supabase start`. Production: Dashboard → Settings → API.
VITE_SUPABASE_ANON_KEY=

# Sentry DSN for error tracking (free tier: 5k errors/month).
# From sentry.io → Project → Settings → Client Keys (DSN). Optional in local dev.
SENTRY_DSN=

# Google OAuth for "Continue with Google" (free). Read by `supabase start` from
# the shell environment (not from packages/web/.env). Create a Web OAuth client
# in Google Cloud Console → Credentials, with the Supabase callback URL as an
# authorized redirect URI. Optional locally — email OTP works without it.
# The cloud project is configured in Dashboard → Authentication → Providers.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
