# Local/CI test wiring for the Edge Functions (KAR-52).
#
# Committed on purpose, and safe to commit: it holds no secret, only the
# in-cluster address of the `expo-stub` function. `kong:8000` is how one
# Edge Function reaches another from inside the Supabase docker network —
# 127.0.0.1 there is the runtime container itself, not the gateway.
#
# Used by:
#   supabase functions serve --no-verify-jwt --env-file supabase/functions/.env.test
#   NALVITA_EXPO_STUB=1 npm run test:integration
#
# Without this the send function calls the real Expo API, which is why the
# pruning tests refuse to run unless NALVITA_EXPO_STUB is set.
EXPO_PUSH_URL=http://kong:8000/functions/v1/expo-stub
