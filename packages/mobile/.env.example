# Expo inlines anything prefixed EXPO_PUBLIC_ into the bundle, so everything
# here is public by design. The anon key is meant to be — row-level security is
# the authorization layer, not the key. Never put a secret in this file.

# From `supabase start` locally, or the cloud project's API settings.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Origin of the deployed web app. Invite and handover links are built from this,
# because they must open somewhere a person without the app installed can reach.
EXPO_PUBLIC_APP_BASE_URL=https://nalvita.app
